# Names only. Copy this file to .env.local and fill the values there.
# Do not commit values. Supabase is not connected in this skeleton.

# Project URL. Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (dashboard label: anon public, or the publishable key).
# Safe for the browser. Row level security still applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Server only. Bypasses row level security.
# Never prefix this name with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
