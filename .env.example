# Names only. Copy this file to .env.local and fill the values there.
# Do not commit values.
# When the URL and anon key are set, the app uses Supabase Auth (email and
# password) and SupabaseDuesRepository. Leave them empty to keep the mock.

# Project URL. Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (dashboard label: anon public, or the publishable key).
# Safe for the browser. Row level security still applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Server only. Bypasses row level security.
# Never prefix this name with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public sample site. Set to true to show the test banner and passwordless
# demo sign-in in a production build. Leave empty for a real deployment.
# Sample edits reset when that server process starts cold.
NEXT_PUBLIC_DUESKO_TEST_SITE=

# Public waitlist. Leave unset until the privacy notice is approved.
# Set to true only to accept signups. Production Vercel stays unset.
NEXT_PUBLIC_DUESKO_WAITLIST_OPEN=
